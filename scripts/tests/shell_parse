#!/bin/bash

# Verifies every shipped shell script parses.

set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
cd "$SCRIPT_DIR/../.."

echo "==> bash -n"
bash -n build-tools.sh
for script in scripts/tests/*; do
	[ -f "$script" ] || continue
	# Suite scripts are extensionless executables; only syntax-check the ones
	# whose shebang is bash.
	head -1 "$script" | grep -q '^#!/bin/bash' || continue
	bash -n "$script"
done
echo "    ok: all shell scripts parse"